{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "rootDir": ".",
    "types": ["node"],
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["App.tsx", "src"],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.test.tsx"]
}